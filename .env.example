# Amadeus Travel API — https://developers.amadeus.com
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here

# Unsplash API — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# OpenWeatherMap API — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Stripe — https://stripe.com/docs/keys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Google AdSense — https://www.google.com/adsense
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-your_publisher_id_here

# Booking.com Partner API — https://developers.booking.com
BOOKING_AFFILIATE_ID=your_booking_affiliate_id_here

# Skyscanner Affiliate — https://partners.skyscanner.net
SKYSCANNER_API_KEY=your_skyscanner_api_key_here

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000
